<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VisionVogue - Return Product</title>
    <link rel="stylesheet" href="/css/return.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <header class="navbar">
        <nav class="nav-links">
            <a href="/home">Home</a>
            <a href="/shop">shop</a>
            <a href="#">About</a>
            <a href="#">Contact us</a>
        </nav>
        <div class="logo">VisionVogue</div>
        <div class="nav-icons">
            <a href="/wishlist" class="wishlist-icon-container" style="position: relative; display: inline-block;">
                <i class="fa-regular fa-heart"></i>
                <% if (locals.wishlistCount > 0) { %>
                    <span class="wishlist-badge"><%= wishlistCount %></span>
                <% } %>
            </a>
            <a href="/cart" class="cart-icon-container"><i class="fa-solid fa-cart-shopping"></i>
                <% if (locals.cartCount > 0) { %>
                    <span class="cart-badge"><%= cartCount %></span>
                <% } %>
            </a>
            <a href="/profile"><i class="fa-regular fa-user"></i></a>
        </div>
    </header>

    <main class="profile-container">
        <p>Order -> Return Item</p>
        
        <div class="content-wrapper">
            <aside class="sidebar">
                <h3>My Account</h3>
                <ul>
                   <a href="/profile"><li>Profile</li></a>
                   <a href="/address"><li>Address</li></a>
                   <a href="/order"><li class="active">Order</li></a>
                   <a href="/wallet"><li>Wallet</li></a>
                   <a href="/Coupon"><li>Coupon</li></a>
                   <a href="/refer"><li>Refer & Earn</li></a>
                   <a href="/password"><li>Change Password</li></a>
                   <a href="/logout"><li>Log out</li></a>
                </ul>
            </aside>

            <section class="profile-card">
                <div class="return-card-premium">
                    <div class="return-header">
                        <h2>Return Product Request</h2>
                        <span class="order-badge">Order ID: #<%= order.orderId %></span>
                    </div>

                    <form id="returnForm" class="return-form">
                        <!-- Hidden fields to identify the exact order and unique product item -->
                        <input type="hidden" name="orderId" id="orderId" value="<%= order._id %>">
                        <% const targetItem = order.orderedItems[0]; %>
                        <input type="hidden" name="productId" id="productId" value="<%= targetItem.productId._id %>">
                        
                        <p class="instruction-text">Item selected for return:</p>

                        <div class="product-selection-grid">
                            <!-- Clean Display Card with No Checkbox -->
                            <div class="product-item-card static-preview">
                                <div class="card-content">
                                    <div class="img-wrapper">
                                        <img src="/uploads/<%= targetItem.productId.productimage[0] %>" alt="<%= targetItem.productId.productName %>">
                                    </div>
                                    <div class="product-info">
                                        <h4><%= targetItem.productId.productName %></h4>
                                        <p class="category">Category: <%= targetItem.productId.category ? targetItem.productId.category.name : 'N/A' %></p>
                                        <p class="price">₹<%= targetItem.price %> <span class="qty">Qty: <%= targetItem.quantity %></span></p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="reason-section">
                            <label for="reason">Reason for Return</label>
                            <div class="textarea-wrapper">
                                <textarea id="reason" name="reason" required placeholder="Please provide a descriptive reason for returning this item..."></textarea>
                            </div>
                        </div>

                        <div class="form-actions">
                            <a href="/order" class="btn-secondary">Cancel</a>
                            <button type="button" onclick="submitReturn()" class="btn-primary">Submit Return Request</button>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </main>

    <footer class="footer">
        <div class="footer-columns">
            <div class="col">
                <h4>About Us:</h4>
                <p>Our Story</p><p>Privacy Policy</p><p>Terms</p><p>FAQ</p>
            </div>
            <div class="col">
                <h4>Support:</h4>
                <p>Shipping Policy</p><p>Returns</p><p>Order Tracking</p><p>Help</p>
            </div>
            <div class="col">
                <h4>My Account:</h4>
                <p>Profile</p><p>My Orders</p><p>Wishlist</p><p>Refer & Earn</p>
            </div>
            <div class="col">
                <h4>Contact:</h4>
                <p>Email: visionvogue@gmail.com</p>
                <p>Phone: 8923457190</p>
            </div>
        </div>
        <p class="copyright">© 2026 Eyewear Store. All rights reserved.</p>
    </footer>

<script>
    // Page history state management boilerplate
    window.addEventListener("pageshow", function (event) {
        var historyTraversal = event.persisted || 
                               (typeof window.performance != "undefined" && 
                                window.performance.navigation.type === 2);
        if (historyTraversal) {
            window.location.reload();
        }
    });
    window.history.pushState(null, null, window.location.href);
    window.onpopstate = function () {
        window.history.go(1);
    };

    function submitReturn() {
        const orderId = document.getElementById('orderId').value;
        const productId = document.getElementById('productId').value;
        const reason = document.getElementById('reason').value;

        if (reason.trim().length < 10) {
            return Swal.fire('More Detail', 'Please provide a more detailed reason (min 10 characters).', 'warning');
        }

        Swal.fire({
            title: 'Confirm Return?',
            text: "Are you sure you want to request a return for this item?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#000',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Process it!'
        }).then((result) => {
            if (result.isConfirmed) {
                fetch('/returnSubmit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        orderId: orderId, 
                        productId: productId, 
                        reason: reason 
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.status) {
                        Swal.fire('Success', 'Return request submitted successfully!', 'success')
                        .then(() => window.location.href = `/order`);
                    } else {
                        Swal.fire('Error', data.message, 'error');
                    }
                })
                .catch(err => {
                    Swal.fire('Error', 'Something went wrong with the server.', 'error');
                });
            }
        });
    }
</script>
</body>
</html>