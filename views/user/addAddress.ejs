<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VisionVogue - Profile</title>
    <link rel="stylesheet" href="css/addAddress.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>

    <header class="navbar">
        <nav class="nav-links">
            <a href="#">Home</a>
            <a href="#">shop</a>
            <a href="#">About</a>
            <a href="#">Contact us</a>
        </nav>
        <div class="logo">VisionVogue</div>
        <div class="nav-icons">
              <a href="/wishlist" class="wishlist-icon-container" style="position: relative; display: inline-block;">
        <i class="fa-regular fa-heart"></i>
        <% if (locals.wishlistCount > 0) { %>
            <span class="wishlist-badge"><%= wishlistCount %></span>
        <% } %>
    </a>
               <a href="/cart" class="cart-icon-container"><i class="fa-solid fa-cart-shopping"></i>
                <% if (locals.cartCount > 0) { %>
            <span class="cart-badge"><%= cartCount %></span>
        <% } %>
            </a>
              <a href="" > <i class="fa-regular fa-user"></i></a>
    </header>

    <main class="profile-container">
        <p>Address -> New Address</p>
        
        <div class="content-wrapper">
            <aside class="sidebar">
                <h3>My Account</h3>
                <ul>
                   <a href="/profile"><li>Profile</li></a>
                   <a href="/address"> <li class="active">Address</li> </a>
                   <a href="/order"><li>Order</li> </a>
                   <a href="/wallet"><li>Wallet</li> </a>
                   <a href="/Coupon"> <li>Coupon</li> </a>
                   <a href="/refer" ><li>Refer & Earn</li> </a>
                   <a href="/password"><li>Change Password</li> </a>
                   <a href="/logout"><li>Log out</li> </a>
                </ul>
            </aside>
           <main class="profile-container">
    <div class="form-wrapper-centered">

        <div class="form-card-premium">
            <div class="form-header">
                <div class="icon-circle">
                    <i class="fa-solid fa-location-dot"></i>
                </div>
                <h2>New Shipping Address</h2>
                <p>Add a new location for your deliveries</p>
            </div>

            <form method="post" action="/addAddress" id="addressForm">
                <div class="form-grid">
                    <div class="form-group full-width">
                        <label>Address Type</label>
                        <input type="text" id="addressType" name="addressType" placeholder="Address Type" >
                        <span id="addressTypeError" class="error-text" style="color: #ff4d4d; display: none; font-size: 13px; margin-top: 4px;"></span>
                    </div>

                    <div class="form-group">
                        <label>House Name/No.</label>
                        <input type="text" id="houseName" name="houseName" placeholder="House Name" >
                        <span id="houseNameError" class="error-text" style="color: #ff4d4d; display: none; font-size: 13px; margin-top: 4px;"></span>
                    </div>

                    <div class="form-group">
                        <label>Street</label>
                        <input type="text" id="street" name="street" placeholder="Street">
                        <span id="streetError" class="error-text" style="color: #ff4d4d; display: none; font-size: 13px; margin-top: 4px;"></span>
                    </div>

                    <div class="form-group full-width">
                        <label>Landmark</label>
                        <input type="text" id="landmark" name="landmark" placeholder="Landmark">
                        <span id="landmarkError" class="error-text" style="color: #ff4d4d; display: none; font-size: 13px; margin-top: 4px;"></span>
                    </div>

                    <div class="form-group">
                        <label>City</label>
                        <input type="text" id="city" name="city" placeholder="City" >
                        <span id="cityError" class="error-text" style="color: #ff4d4d; display: none; font-size: 13px; margin-top: 4px;"></span>
                    </div>

                    <div class="form-group">
                        <label>Zip Code</label>
                        <input type="text" id="zipCode" name="zipCode" placeholder="Zip Code" >
                        <span id="zipCodeError" class="error-text" style="color: #ff4d4d; display: none; font-size: 13px; margin-top: 4px;"></span>
                    </div>

                    <div class="form-group">
                        <label>Country</label>
                        <input type="text" id="country" name="country" placeholder="Country" >
                        <span id="countryError" class="error-text" style="color: #ff4d4d; display: none; font-size: 13px; margin-top: 4px;"></span>
                    </div>

                    <div class="form-group">
                        <label>Phone Number</label>
                        <input type="text" id="phoneNumber" name="phoneNumber" placeholder="Phone Number" >
                        <span id="phoneNumberError" class="error-text" style="color: #ff4d4d; display: none; font-size: 13px; margin-top: 4px;"></span>
                    </div>
                </div>

                <div id="formError" class="error-message" style="margin-top: 10px; font-weight: bold;"></div>

                <div class="form-actions">
                    <button type="submit" class="btn-save">
                        Save Address <i class="fa-solid fa-check"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>
        </div>
    </main>

    <footer class="footer">
        <div class="footer-columns">
            <div class="col">
                <h4>About Us:</h4>
                <p>Our Story</p><p>Privacy Policy</p><p>Terms</p><p>FAQ</p>
            </div>
            <div class="col">
                <h4>Support:</h4>
                <p>Shipping Policy</p><p>Returns</p><p>Order Tracking</p><p>Help</p>
            </div>
            <div class="col">
                <h4>My Account:</h4>
                <p>Profile</p><p>My Orders</p><p>Wishlist</p><p>Refer & Earn</p>
            </div>
            <div class="col">
                <h4>Contact:</h4>
                <p>Email: visionvogue@gmail.com</p>
                <p>Phone: 8923457190</p>
            </div>
        </div>
        <p class="copyright">© 2026 Eyewear Store. All rights reserved.</p>
    </footer>
<script>
document.getElementById('addressForm').addEventListener('submit', function(e) {
    const addressType = document.getElementById('addressType').value.trim();
    const houseName = document.getElementById('houseName').value.trim();
    const street = document.getElementById('street').value.trim();
    const landmark = document.getElementById('landmark').value.trim();
    const city = document.getElementById('city').value.trim();
    const zipCode = document.getElementById('zipCode').value.trim();
    const country = document.getElementById('country').value.trim();
    const phoneNumber = document.getElementById('phoneNumber').value.trim();
    const formError = document.getElementById('formError');

    const phoneRegex = /^[6-9]\d{9}$/; 
    const zipRegex = /^\d{6}$/;      
    
    let isValid = true;
    document.querySelectorAll('.error-text').forEach(el => {
        el.innerText = "";
        el.style.display = "none";
    });
    formError.innerText = "";
    formError.style.display = "none";
    if (!addressType) {
        showFieldError('addressTypeError', 'Address type is required (e.g., Home, Office).');
        isValid = false;
    }
    if (!houseName) {
        showFieldError('houseNameError', 'House Name or Number is required.');
        isValid = false;
    }
    if (!street) {
        showFieldError('streetError', 'Street name or area is required.');
        isValid = false;
    }
    if (!landmark) {
        showFieldError('landmarkError', 'Landmark is required for easy delivery.');
        isValid = false;
    }
    if (!city) {
        showFieldError('cityError', 'City is required.');
        isValid = false;
    }
    if (!zipCode) {
        showFieldError('zipCodeError', 'Zip Code is required.');
        isValid = false;
    } else if (!zipRegex.test(zipCode)) {
        showFieldError('zipCodeError', 'Please enter a valid 6-digit Zip Code.');
        isValid = false;
    }
    if (!country) {
        showFieldError('countryError', 'Country name is required.');
        isValid = false;
    }
    if (!phoneNumber) {
        showFieldError('phoneNumberError', 'Phone number is required.');
        isValid = false;
    } else if (!phoneRegex.test(phoneNumber)) {
        showFieldError('phoneNumberError', 'Enter a valid 10-digit number starting with 6-9.');
        isValid = false;
    }
    if (!isValid) {
        e.preventDefault(); 
        formError.innerText = "Please fix the highlighted errors above.";
        formError.style.display = "block";
        formError.style.color = "#ff4d4d";
        const firstError = document.querySelector('.error-text[style*="display: block"]');
        if (firstError) {
            firstError.parentElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    }
});

function showFieldError(elementId, message) {
    const errorSpan = document.getElementById(elementId);
    if (errorSpan) {
        errorSpan.innerText = message;
        errorSpan.style.display = "block";
    }
}
</script>


</body>
</html>