<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Professional Admin Dashboard</title>
    <link rel="stylesheet" href="/css/addProduct.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
</head>
<body>

    <div class="dashboard-container">
        <aside class="sidebar">
            <div class="nav-item ">
                <a href="/admin/dashboard">
                <i class="fas fa-th-large"></i> <span>Dashboard</span>
                </a>
            </div>
            <div class="nav-item active">
                <a href="/admin/product">
                <i class="fas fa-box"></i> <span>Product Management</span>
                </a>
            </div>
            <div class="nav-item">
                <a href="/admin/orderManagement">
                <i class="fas fa-shopping-cart"></i> <span>Order Management</span>
                </a>
            </div>
            <div class="nav-item">
                <a href="/admin/customer">
                <i class="fas fa-user"></i> <span>User Management</span>
                </a>
            </div>
           <div class="nav-item">
                <a href="/admin/category">
                <i class="fas fa-layer-group"></i> <span>Category Management</span>
                </a>
            </div>
            <div class="nav-item">
                <a href="/admin/banner">
                <i class="fas fa-image"></i> <span>Banner Management</span>
                </a>
            </div>
            <div class="nav-item">
                <a href="/admin/inventory">
                <i class="fa-solid fa-clipboard-list"></i> <span>Invetry Management</span>
                </a>
            </div>
            <hr class="nav-divider">

            <div class="nav-item">
                <a href="/admin/couponManagement">
                <i class="fas fa-ticket-alt"></i> <span>Coupon</span>
                </a>
            </div>
            <div class="nav-item">
                <a href="/admin/brand">
                 <i class="fa-solid fa-tags"></i><span>Brand</span>
                </a>
            </div>
             <div class="nav-item">
                <a href="/admin/Reviews">
                <i class="fas fa-comment-alt"></i> <span>Review</span>
                </a>
            </div>
            <div class="nav-item">
                <a href="/admin/offer">
                <i class="fas fa-tag"></i> <span>Offers</span>
                </a>
            </div>
        </aside>

        <main class="main-content">
            <header class="top-header">
                <h2>Product Management</h2>
                <a href="/admin/logout">
                <button class="logout-top">Log out</button>
                </a>
            </header>
            <section class="content-body">
                <h3>Add Product</h3>
       <form id="productForm" method="post" action="/admin/product" enctype="multipart/form-data">
    <div class="form-row">
        <div>
            <label>Product Name</label>
            <input type="text" id="productName" name="productName" placeholder="Enter product name">
            <span id="nameError" class="error-text" style="color: red; display: none; font-size: 13px;"></span>
        </div>
        <div>
            <label>Category</label>
             <select name="category">
                <%for(let i=0;i<cat.length;i++){%>
                    <option value="<%=cat[i].name%>"><%=cat[i].name%></option>
                    <%=cat[i].name%>
                    <%}%>
             </select>
        </div>
        
    </div>

    <div class="form-row full-width">
        <div>
            <label>Description</label>
            <textarea name="description" id="description" placeholder="Enter product description"></textarea>
            <span id="descriptionError" class="error-text" style="color: red; display: none; font-size: 13px;"></span>
        </div>
    </div>
    <div class="form-row">
        <div>
            <label>Regular Price</label>
            <input type="number" id="regularPrice" name="regularPrice" placeholder="0.00">
            <span id="regularPriceError" class="error-text" style="color: red; display: none; font-size: 13px;"></span>
        </div>
        <div>
            <label>Sale Price</label>
            <input type="number" id="salesPrice" name="salesPrice" placeholder="0.00">
            <span id="salesPriceError" class="error-text" style="color: red; display: none; font-size: 13px;"></span>
        </div>
    </div>

    <div class="form-row">
        <div>
            <label>Brand</label>
             <select name="brand" id="brand">
                <%for(let i=0;i<brand.length;i++){%>
                    <option value="<%=brand[i].name%>"><%=brand[i].name%></option>
                    <%=brand[i].name%>
                    <%}%>
             </select>
        </div>
        <div>
            <label>Quantity</label>
            <input type="number" id="quantity" name="quantity" placeholder="Enter quantity">
            <span id="quantityError" class="error-text" style="color: red; display: none; font-size: 13px;"></span>
        </div>
    </div>
    <div class="image-upload-section">
        <h3>Product Images</h3>
        <div class="upload-group" style="border: 1px solid #ccc; padding: 15px;">
            <label>Product Image 1:</label>
            <input type="file" name="productimage" class="imageInput" data-index="0" accept="image/*">
            <div class="crop-wrapper" id="wrapper-0" style="display: flex; gap: 20px; margin-top: 10px;"></div>
            <span id="imageError-0" class="error-text" style="color: red; display: none; font-size: 13px; margin-top: 5px;"></span>
        </div>

        <div class="upload-group" style="border: 1px solid #ccc; padding: 15px;">
            <label>Product Image 2:</label>
            <input type="file" name="productimage" class="imageInput" data-index="1" accept="image/*">
            <div class="crop-wrapper" id="wrapper-1" style="display: flex; gap: 20px; margin-top: 10px;"></div>
            <span id="imageError-1" class="error-text" style="color: red; display: none; font-size: 13px; margin-top: 5px;"></span>
        </div>

        <div class="upload-group"  style="border: 1px solid #ccc; padding: 15px;">
            <label>Product Image 3:</label>
            <input type="file"name="productimage" class="imageInput" data-index="2" accept="image/*">
            <div class="crop-wrapper" id="wrapper-2" style="display: flex; gap: 20px; margin-top: 10px;"></div>
            <span id="imageError-2" class="error-text" style="color: red; display: none; font-size: 13px; margin-top: 5px;"></span>
        </div>
        <div class="upload-group"  style="border: 1px solid #ccc; padding: 15px;">
            <label>Product Image 4:</label>
            <input type="file"name="productimage" class="imageInput" data-index="3" accept="image/*">
            <div class="crop-wrapper" id="wrapper-3" style="display: flex; gap: 20px; margin-top: 10px;"></div>
            <span id="imageError-3" class="error-text" style="color: red; display: none; font-size: 13px; margin-top: 5px;"></span>
        </div>
    </div>
     <div id="formError" class="error-message full-width" style="color: red; font-weight: bold; margin-bottom: 10px;"></div>
    <div class="submit-container">
        <button type="submit" class="btn-save">Save Product</button>
    </div>
</form>
    </section>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
<script>
    const form = document.getElementById("productForm");
    const imageInputs = document.querySelectorAll(".imageInput");
    
    let finalBlobs = [null, null, null,null]; 
    let croppers = [null, null, null,null];

    imageInputs.forEach(input => {
        input.addEventListener("change", (e) => {
            const index = e.target.getAttribute("data-index");
            const wrapper = document.getElementById(`wrapper-${index}`);
            const file = e.target.files[0];

            if (!file) return;

            wrapper.innerHTML = "";
            if (croppers[index]) {
                croppers[index].destroy();
                croppers[index] = null;
            }

            const reader = new FileReader();
            reader.onload = (event) => {
                const imgDiv = document.createElement("div");
                imgDiv.id = `img-container-${index}`;
                imgDiv.style.width = "300px";
                
                const img = document.createElement("img");
                img.src = event.target.result;
                img.style.maxWidth = "100%";
                imgDiv.appendChild(img);

                const controlDiv = document.createElement("div");
                controlDiv.style.display = "flex";
                controlDiv.style.flexDirection = "column";
                controlDiv.style.gap = "10px";

                const saveBtn = document.createElement("button");
                saveBtn.innerText = "Confirm Crop";
                saveBtn.type = "button";
                saveBtn.style.cssText = "background: #007bff; color: white; padding: 5px 10px; border: none; cursor: pointer;";

                const previewImg = document.createElement("img");
                previewImg.style.cssText = "max-width: 150px; display: none; border: 2px solid #28a745; border-radius: 4px;";

                controlDiv.appendChild(saveBtn);
                controlDiv.appendChild(previewImg);

                wrapper.appendChild(imgDiv);
                wrapper.appendChild(controlDiv);

                croppers[index] = new Cropper(img, {
                    aspectRatio: 1,
                    viewMode: 1
                });
               saveBtn.addEventListener("click", () => {
    if (croppers[index]) {
        const canvas = croppers[index].getCroppedCanvas({ width: 440, height: 440 });
        previewImg.src = canvas.toDataURL("image/jpeg");
        previewImg.style.display = "block";
        croppers[index].destroy();
        croppers[index] = null;
        imgDiv.style.border = "1px solid #ccc"; 
        imgDiv.style.opacity = "0.8";

        canvas.toBlob((blob) => {
            finalBlobs[index] = blob;
        }, "image/jpeg");

        saveBtn.innerText = "Saved ";
        saveBtn.style.background = "#28a745";
        saveBtn.disabled = true; 
    }
});
            };
            reader.readAsDataURL(file);
        });
    });
    
    const addProduct = document.querySelector('form');
const productName = document.getElementById('productName');
const description = document.getElementById('description');
const regularPrice = document.getElementById('regularPrice');
const salesPrice = document.getElementById('salesPrice');
const quantity = document.getElementById('quantity');
const formError = document.getElementById('formError');

addProduct.addEventListener('submit', function(e) {
    let isValid = true;
    document.querySelectorAll('.error-text').forEach(el => {
        el.innerHTML = '';
        el.style.display = 'none';
    });
    formError.innerHTML = '';
    if (productName.value.trim() === '') {
        showError('nameError', 'Product name is required');
        isValid = false;
    }
    if (description.value.trim() === '') {
        showError('descriptionError', 'Description is required');
        isValid = false;
    }
    const regPriceVal = Number(regularPrice.value);
    if (regularPrice.value.trim() === '') {
        showError('regularPriceError', 'Regular price is required');
        isValid = false;
    } else if (regPriceVal <= 0) {
        showError('regularPriceError', 'Regular price must be greater than 0');
        isValid = false;
    }
    const salePriceVal = Number(salesPrice.value);
    if (salesPrice.value.trim() === '') {
        showError('salesPriceError', 'Sale price is required');
        isValid = false;
    } else if (salePriceVal < 0) {
        showError('salesPriceError', 'Sale price cannot be negative');
        isValid = false;
    } else if (salePriceVal >= regPriceVal) {
        showError('salesPriceError', 'Sale price must be less than Regular price');
        isValid = false;
    }
    const qtyVal = Number(quantity.value);
    if (quantity.value.trim() === '') {
        showError('quantityError', 'Quantity (Stock) is required');
        isValid = false;
    } else if (qtyVal < 0) {
        showError('quantityError', 'Stock cannot be negative');
        isValid = false;
    } else if (!Number.isInteger(qtyVal)) {
        showError('quantityError', 'Stock must be a valid whole number');
        isValid = false;
    }
    for (let i = 0; i < finalBlobs.length; i++) {
        if (finalBlobs[i] === null) {
            showError(`imageError-${i}`, `Please upload and confirm crop for Product Image ${i + 1}`);
            isValid = false;
        }
    }
    if (!isValid) {
        e.preventDefault();
        formError.innerHTML = 'Please fix the errors above before saving.';
    }
});
function showError(elementId, message) {
    const errorSpan = document.getElementById(elementId);
    if (errorSpan) {
        errorSpan.innerHTML = message;
        errorSpan.style.display = 'block';
    }
}

</script>
</body>
</html>