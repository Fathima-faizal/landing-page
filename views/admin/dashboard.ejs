<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Professional Admin Dashboard</title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.25/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
</head>
<body>

<div class="dashboard-container">
    <aside class="sidebar">
        <div class="nav-item active">
            <a href="/admin/dashboard">
                <i class="fas fa-th-large"></i> <span>Dashboard</span>
            </a>
        </div>
        <div class="nav-item">
            <a href="/admin/product">
                <i class="fas fa-box"></i> <span>Product Management</span>
            </a>
        </div>
        <div class="nav-item">
            <a href="/admin/orderManagement">
                <i class="fas fa-shopping-cart"></i> <span>Order Management</span>
            </a>
        </div>
        <div class="nav-item">
            <a href="/admin/customer">
                <i class="fas fa-user"></i> <span>User Management</span>
            </a>
        </div>
        <div class="nav-item">
            <a href="/admin/category">
                <i class="fas fa-layer-group"></i> <span>Category Management</span>
            </a>
        </div> 
        <div class="nav-item">
            <a href="/admin/banner">
                <i class="fas fa-image"></i> <span>Banner Management</span>
            </a>
        </div>
        <div class="nav-item">
            <a href="/admin/inventory">
                <i class="fa-solid fa-clipboard-list"></i> <span>Invetry Management</span>
            </a>
        </div>
        <hr class="nav-divider">

        <div class="nav-item">
            <a href="/admin/couponManagement">
                <i class="fas fa-ticket-alt"></i> <span>Coupon</span>
            </a>
        </div>
        <div class="nav-item">
            <a href="/admin/brand">
                <i class="fa-solid fa-tags"></i><span>Brand</span>
            </a>
        </div>
        <div class="nav-item">
            <a href="/admin/Reviews">
                <i class="fas fa-comment-alt"></i> <span>Review</span>
            </a>
        </div>
        <div class="nav-item">
            <a href="/admin/offer">
                <i class="fas fa-tag"></i> <span>Offers</span>
            </a>
        </div>
    </aside>

    <main class="main-content">
        <header class="top-header">
            <h2>Admin Dashboard</h2>
            <a href="/admin/logout"><button class="logout-top">Log out</button></a>
        </header>

        <div class="content-body">
            
            <div class="stats-grid">
                <div class="stat-card"><i class="fas fa-users"></i><div><p>Users</p><h3><%= userCount %></h3></div></div>
                <div class="stat-card"><i class="fas fa-shopping-cart"></i><div><p>Delivered Orders</p><h3><%= orderCount %></h3></div></div>
                <div class="stat-card"><i class="fas fa-wallet"></i><div><p>Total Revenue</p><h3>₹<%= revenue %></h3></div></div>
            </div>

           <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 20px 0;">
    <div style="background: white; padding: 20px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); min-height: 250px;">
        <h3 style="margin-bottom: 15px; color:#2c3e50;"><i class="fas fa-fire" style="color:#e67e22;"></i> Top 2 Best Selling Products</h3>
        <table style="width:100%; border-collapse: collapse; font-size: 0.9rem; table-layout: fixed;">
            <thead>
                <tr style="border-bottom: 2px solid #edf2f7; text-align: left;">
                    <th style="padding: 10px 8px; width: 70%;">Product Name</th>
                    <th style="padding: 10px 8px; text-align: center; width: 30%;">Qty Sold</th>
                </tr>
            </thead>
            <tbody>
                <% if (topProducts && topProducts.length > 0) { %>
                    <% topProducts.forEach(prod => { %>
                        <tr style="border-bottom: 1px solid #edf2f7;">
                            <td style="padding: 12px 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                <%= prod.productName || 'Unknown Product' %>
                            </td>
                            <td style="padding: 12px 8px; text-align: center; font-weight: bold; color: #2c3e50;">
                                <%= prod.totalQty %>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="2" style="padding: 20px; text-align: center; color: #888;">No product sales recorded yet.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <div style="background: white; padding: 20px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); min-height: 250px;">
        <h3 style="margin-bottom: 15px; color:#2c3e50;"><i class="fas fa-chart-pie" style="color:#9b59b6;"></i> Top 2 Trending Categories</h3>
        <table style="width:100%; border-collapse: collapse; font-size: 0.9rem; table-layout: fixed;">
            <thead>
                <tr style="border-bottom: 2px solid #edf2f7; text-align: left;">
                    <th style="padding: 10px 8px; width: 70%;">Category</th>
                    <th style="padding: 10px 8px; text-align: center; width: 30%;">Items Sold</th>
                </tr>
            </thead>
            <tbody>
                <% if (topCategories && topCategories.length > 0) { %>
                    <% topCategories.forEach(cat => { %>
                        <tr style="border-bottom: 1px solid #edf2f7;">
                            <td style="padding: 12px 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                <%= cat.categoryName || 'Uncategorized' %>
                            </td>
                            <td style="padding: 12px 8px; text-align: center; font-weight: bold; color: #2c3e50;">
                                <%= cat.itemCount %>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="2" style="padding: 20px; text-align: center; color: #888;">No category metrics tracked yet.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
            <div style="margin: 20px 0; display: flex; justify-content: flex-end;">
                <button id="toggleBtn" onclick="toggleDashboard()" class="filter-btn" style="min-width: 180px; background-color: #3498db; color: white; border: none; padding: 10px; border-radius: 5px; cursor: pointer; font-weight: bold;">
                    Show Sales Report
                </button>
            </div>

            <div id="revenueSection" class="charts-container" style="background: white; padding: 20px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                <h3>Revenue Analytics (Monthly)</h3>
                <div style="height: 300px;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>

            <div id="salesSection" class="report-section" style="margin-top: 20px; display: none;">
                <div class="report-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <div>
                        <h3>Sales Report </h3>
                        <p id="reportPeriod" style="font-size: 0.9rem; color: #666; margin-top: 5px;">Showing all processed data </p>
                    </div>
                    <div class="filter-group">
                        <select id="filterType" onchange="toggleDateInputs()">
                            <option value="custom">Custom Range</option>
                            <option value="daily">Daily</option>
                            <option value="weekly">Weekly</option>
                            <option value="yearly">Yearly</option>
                        </select>
                        <input type="date" id="startDate">
                        <input type="date" id="endDate">
                        <button class="filter-btn" onclick="applyFilter()"><i class="fas fa-filter"></i> Filter</button>
                    </div>
                </div>

                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Order ID</th>
                            <th>Base Price</th>
                            <th>Discount Applied</th>
                            <th>Final Revenue</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% salesReport.forEach(order => { %>
                        <tr>
                            <td><%= order.createdOn.toLocaleDateString() %></td>
                            <td>#<%= order._id.toString() %></td>
                            <td>₹<%= order.totalPrice %></td>
                            <td>₹<%= order.discount %></td>
                            <td>₹<%= order.finalAmount %></td>
                            <td class="status-green"><%= order.status.toUpperCase() %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>

                <div style="margin-top: 20px; display: flex; justify-content: flex-end; gap: 10px;">
                    <button class="download-btn" onclick="downloadPDF()" style="background: #e74c3c; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer;">
                        <i class="fas fa-file-pdf"></i> Download PDF
                    </button>
                    <button class="download-btn" onclick="downloadExcel()" style="background: #27ae60; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer;">
                        <i class="fas fa-file-excel"></i> Download Excel
                    </button>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const today = new Date();
        const dd = String(today.getDate()).padStart(2, '0');
        const mm = String(today.getMonth() + 1).padStart(2, '0'); 
        const yyyy = today.getFullYear();
        const todayFormatted = yyyy + '-' + mm + '-' + dd;
        const startInput = document.getElementById('startDate');
        const endInput = document.getElementById('endDate');
        
        if(startInput && endInput) {
            startInput.setAttribute('max', todayFormatted);
            endInput.setAttribute('max', todayFormatted);
            startInput.addEventListener('change', function() {
                endInput.setAttribute('min', startInput.value);
            });
        }
    });

    function toggleDateInputs() {
        const type = document.getElementById('filterType').value;
        const startInput = document.getElementById('startDate');
        const endInput = document.getElementById('endDate');
        if(type !== 'custom') {
            startInput.style.display = 'none';
            endInput.style.display = 'none';
        } else {
            startInput.style.display = 'inline-block';
            endInput.style.display = 'inline-block';
        }
    }

    function toggleDashboard() {
        const revenue = document.getElementById('revenueSection');
        const sales = document.getElementById('salesSection');
        const btn = document.getElementById('toggleBtn');

        if (revenue.style.display === 'none') {
            revenue.style.display = 'block';
            sales.style.display = 'none';
            btn.innerText = 'Show Sales Report';
            btn.style.backgroundColor = '#3498db';
        } else {
            revenue.style.display = 'none';
            sales.style.display = 'block';
            btn.innerText = 'Show Revenue Analytics';
            btn.style.backgroundColor = '#2c3e50';
        }
    }

    // Chart Render Configuration
    const rawData = JSON.parse('<%- chartData %>'); 
    const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    const labels = rawData.map(item => months[item._id - 1]);
    const values = rawData.map(item => item.revenue);
    const ctx = document.getElementById('revenueChart').getContext('2d');
    
    const gradient = ctx.createLinearGradient(0, 0, 0, 400);
    gradient.addColorStop(0, 'rgba(52, 152, 219, 0.2)'); 
    gradient.addColorStop(1, 'rgba(52, 152, 219, 0)');  

    new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: 'Growth Analytics',
                data: values,
                borderColor: 'rgba(52, 152, 219, 0.8)', 
                borderWidth: 4,                        
                backgroundColor: gradient, 
                fill: true,
                tension: 0, 
                pointRadius: 6,                        
                pointBackgroundColor: '#3498db'
            }]
        },
        options: { 
            responsive: true, 
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, grid: { color: 'rgba(0, 0, 0, 0.05)' } },
                x: { grid: { display: false } }
            }
        }
    });

    async function applyFilter() {
        const startDate = document.getElementById('startDate').value;
        const endDate = document.getElementById('endDate').value;
        const filterType = document.getElementById('filterType').value;
        const reportPeriod = document.getElementById('reportPeriod');
        
        let displayStart = startDate;
        let displayEnd = endDate || new Date().toISOString().split('T')[0];
        const now = new Date();

        if (filterType === 'daily') {
            displayStart = now.toLocaleDateString();
            displayEnd = now.toLocaleDateString();
        } else if (filterType === 'weekly') {
            let lastWeek = new Date();
            lastWeek.setDate(now.getDate() - 7);
            displayStart = lastWeek.toLocaleDateString();
            displayEnd = now.toLocaleDateString();
        } else if (filterType === 'yearly') {
            displayStart = `01/01/${now.getFullYear()}`;
            displayEnd = now.toLocaleDateString();
        } else if (filterType === 'custom') {
            if (!startDate || !endDate) return alert("Please select both dates");
            displayStart = new Date(startDate).toLocaleDateString();
            displayEnd = new Date(endDate).toLocaleDateString();
        }
        reportPeriod.innerText = `Showing report from ${displayStart} to ${displayEnd}`;

        const response = await fetch(`/admin/salesReport?startDate=${startDate}&endDate=${endDate}&filterType=${filterType}`);
        const data = await response.json();
        updateTable(data);
    }

    function updateTable(data) {
        const tbody = document.querySelector('.report-table tbody');
        tbody.innerHTML = data.map(order => `
            <tr>
                <td>${new Date(order.createdOn).toLocaleDateString()}</td>
                <td>#${order._id.toString()}</td>
                <td>₹${order.totalPrice}</td>
                <td>₹${order.discount}</td>
                <td>₹${order.finalAmount}</td>
                <td class="status-green">${order.status.toUpperCase()}</td>
            </tr>
        `).join('');
    }

    // Helper to calculate sales totals straight from the updated DOM table
    function calculateReportSummary() {
        const rows = document.querySelectorAll(".report-table tbody tr");
        let totalOrders = rows.length;
        let totalBaseAmount = 0;
        let totalDiscountAmount = 0;
        let totalFinalRevenue = 0;

        rows.forEach(row => {
            const cells = row.getElementsByTagName("td");
            if(cells.length >= 5) {
                const base = parseFloat(cells[2].innerText.replace(/[₹,]/g, '')) || 0;
                const disc = parseFloat(cells[3].innerText.replace(/[₹,]/g, '')) || 0;
                const final = parseFloat(cells[4].innerText.replace(/[₹,]/g, '')) || 0;
                
                totalBaseAmount += base;
                totalDiscountAmount += disc;
                totalFinalRevenue += final;
            }
        });

        return { totalOrders, totalBaseAmount, totalDiscountAmount, totalFinalRevenue };
    }

    function downloadPDF() {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();
    const startDateVal = document.getElementById('startDate')?.value || '';
    const endDateVal = document.getElementById('endDate')?.value || '';
    const filterTypeVal = document.getElementById('filterType')?.value || 'custom';
    const periodText = document.getElementById('reportPeriod').innerText;
    const summary = calculateReportSummary();

    // Document Title
    doc.setFontSize(20);
    doc.setTextColor(44, 62, 80);
    doc.setFont(undefined, 'bold');
    doc.text("VisionVogue Sales Report", 14, 15);
    
    doc.setFontSize(9);
    doc.setFont(undefined, 'normal');
    doc.setTextColor(100);
    doc.text(`Generated on: ${new Date().toLocaleString()}`, 14, 21);
        
    let dateRangeText = periodText;
    if (startDateVal && endDateVal) {
        dateRangeText = `Filter Period: ${startDateVal} to ${endDateVal}`;
    } else if (filterTypeVal !== 'custom') {
        dateRangeText = `Filter Type: ${filterTypeVal.toUpperCase()} (${periodText})`;
    }
    doc.text(dateRangeText, 14, 27);

    // Render Summary block structural background matrix container
    doc.setDrawColor(220);
    doc.setFillColor(248, 249, 250);
    // FIXED: Increased background frame height slightly to 26 to comfortably fit multi-line content
    doc.rect(14, 32, 182, 26, 'F');

    doc.setFontSize(10);
    doc.setTextColor(44, 62, 80);
    doc.setFont(undefined, 'bold');
    doc.text("SALES REPORT SUMMARY", 18, 38);
    
    doc.setFont(undefined, 'normal');
    doc.setFontSize(9);
    doc.setTextColor(60);
    
    // FIXED: Replaced '₹' symbol with explicit string standard 'INR ' to strip font spacing corruption completely
    doc.text(`Total Volume: ${summary.totalOrders} Orders`, 18, 45);
    doc.text(`Total Price: INR ${summary.totalBaseAmount.toFixed(2)}`, 18, 51);
    
    doc.text(`Total Discounts Amount: INR ${summary.totalDiscountAmount.toFixed(2)}`, 105, 45);
    doc.text(` Final Revenue: INR ${summary.totalFinalRevenue.toFixed(2)}`, 105, 51);

    doc.autoTable({
        html: '.report-table',
        startY: 64, // Pushed start position safely below our expanded summary card block boundary
        theme: 'grid',
        styles: { fontSize: 8, cellPadding: 3 },
        headStyles: { fillColor: [44, 62, 80], textColor: [255, 255, 255] },
        didParseCell: function (data) {
            // Cleans internal domestic numbers inside rows out cleanly when exporting
            if (data.section === 'body' && [2, 3, 4].includes(data.column.index)) {
                let text = data.cell.raw.innerText || data.cell.raw.textContent;
                // Replaces currency tokens with standard decimal representations safely
                data.cell.text = text.replace(/[₹,]/g, '').trim();
            }
        }
    });

    doc.save("Sales_Report_VisionVogue.pdf");
}
    function downloadExcel() {
        const table = document.querySelector(".report-table");
        const periodText = document.getElementById('reportPeriod').innerText;
        const summary = calculateReportSummary();

        const summaryData = [
            ["VisionVogue Sales Report"],
            [periodText],
            ["Generated on:", new Date().toLocaleString()],
            [],
            ["--- REPORT SUMMARY METRICS ---"],
            ["Total  Orders", summary.totalOrders],
            ["Total  Amount", `₹${summary.totalBaseAmount.toFixed(2)}`],
            ["Total Discounts ", `₹${summary.totalDiscountAmount.toFixed(2)}`],
            ["Final Revenue", `₹${summary.totalFinalRevenue.toFixed(2)}`],
            [], // spacer row
            ["--- ITEM LOG DETAILS ---"]
        ];

        const ws = XLSX.utils.aoa_to_sheet(summaryData);
        // Append domestic DOM table directly underneath summary matrix bounds
        XLSX.utils.sheet_add_dom(ws, table, { origin: -1 });

        const wscols = [
            {wch: 18}, {wch: 25}, {wch: 15}, {wch: 18}, {wch: 18}, {wch: 15}
        ];
        ws['!cols'] = wscols;

        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Sales Summary Logs");
        XLSX.writeFile(wb, "Sales_Report_VisionVogue.xlsx");
    }
</script>
</body>
</html>